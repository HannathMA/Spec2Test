# Spec2Test AI — Environment Configuration

PROJECT_NAME="Spec2Test AI"

# AI Provider Configuration (Default is "local" deterministic mode - No API key required!)
# Supported options: "local", "openai", "groq"
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Test Runner Sandbox Security
TEST_EXECUTION_TIMEOUT_SECONDS=45

# Embedded Local Demo Target Application
DEMO_TARGET_URL=http://127.0.0.1:8000/demo-target
