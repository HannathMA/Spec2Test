{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://spec2test-backend.onrender.com/api/:path*"
    },
    {
      "source": "/demo-target/:path*",
      "destination": "https://spec2test-backend.onrender.com/demo-target/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
